__pycache__/
.env
.DS_Store
node_modules
.vscode
data/*
backend/jupyterhub_cookie_secret
backend/jupyterhub.sqlite

# Markdown files
*.md
!README.md

# Django migrations
# Track migration files so the schema is reproducible across environments
# (dev, CI, prod). __pycache__ is already ignored above.

*.sh
!docker-down.sh
!docker-up.sh

# Allow .txt files in prompts
*.txt
!**/prompts/*.txt
!**/prompts/unique_stories/*.txt

# .sql files
*.sql
package-lock.json

nginx/ssl/

docker_cmds.md

# Binary tarballs (e.g. server snapshots)
*.tgz
*.tar.gz